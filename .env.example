APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==== MAIL - LOCAL DEVELOPMENT (XAMPP) ====
# Untuk testing di komputer lokal, SMTP (mis. Mailtrap sandbox) masih aman dipakai
# karena SMTP TIDAK diblokir di local. Isi MAIL_HOST/PORT/USERNAME/PASSWORD punya
# Mailtrap kamu di sini kalau MAIL_MAILER=smtp.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==== MAIL - PRODUCTION (InfinityFree) ====
# InfinityFree memblokir SEMUA koneksi SMTP keluar, jadi mailer di atas (smtp)
# TIDAK akan jalan di server production. Gunakan provider berbasis HTTP API:
# Resend (config/mail.php & config/services.php sudah siap, tinggal isi key ini).
#
# Langkah singkat (detail lengkap ada di MAIL-PROVIDER-SETUP.md):
#   1. composer require resend/resend-laravel   (sudah ditambahkan ke composer.json,
#      tinggal jalankan `composer update` sekali di lokal untuk download package-nya)
#   2. Daftar akun gratis di https://resend.com, verifikasi domain kamu di sana
#   3. Ambil API key dari dashboard Resend, isi RESEND_API_KEY di bawah
#   4. Di .env PRODUCTION (yang diupload ke InfinityFree via FileZilla), ganti:
#        MAIL_MAILER=resend
#      dan pastikan MAIL_FROM_ADDRESS pakai domain yang sudah diverifikasi di Resend
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login Instan via Google (Laravel Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Notifikasi WhatsApp & Abandoned Cart Recovery (Fonnte)
FONNTE_TOKEN=
FONNTE_ENABLED=false

# Payment Gateway Midtrans
# MIDTRANS_IS_PRODUCTION=false -> pakai sandbox (ada watermark kuning "TEST", ini NORMAL).
# Set true HANYA jika sudah punya Server Key & Client Key PRODUCTION asli dari Midtrans.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
